{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"paths": {
			"@ue-shed/extension-data-authoring/viewer": [
				"../../extensions/data-authoring/src/viewer.ts"
			],
			"@ue-shed/extension-data-authoring/wasm": [
				"../../extensions/data-authoring/src/wasm-reader.ts"
			]
		},
		"jsx": "preserve",
		"jsxImportSource": "@solidjs/web",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"types": ["vite/client"],
		"noEmit": true
	},
	"include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts"],
	"exclude": ["src/**/*.worker.ts"]
}
