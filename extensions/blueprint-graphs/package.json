{
	"name": "@ue-shed/extension-blueprint-graphs",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./contract": {
			"types": "./src/contract.ts",
			"default": "./src/contract.ts"
		},
		"./wasm": {
			"types": "./src/wasm-reader.ts",
			"default": "./src/wasm-reader.ts"
		}
	},
	"scripts": {
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@solidjs/web": "catalog:",
		"@stylexjs/stylex": "catalog:",
		"@ue-shed/blueprints": "workspace:*",
		"@ue-shed/protocol": "workspace:*",
		"@ue-shed/ui": "workspace:*",
		"@ue-shed/ui-theme": "workspace:*",
		"effect": "catalog:",
		"solid-js": "catalog:"
	}
}
