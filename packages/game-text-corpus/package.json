{
	"name": "@ue-shed/game-text-corpus",
	"version": "0.24.0",
	"description": "Compare a host's Game Text index with a generated Unreal corpus's planted answers.",
	"homepage": "https://github.com/ue-shed/ue-shed#readme",
	"bugs": {
		"url": "https://github.com/ue-shed/ue-shed/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ue-shed/ue-shed.git",
		"directory": "packages/game-text-corpus"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "node ../../scripts/clean-package-dist.ts && tsc -p tsconfig.build.json",
		"prepack": "pnpm run build",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@ue-shed/game-text": "workspace:0.24.0",
		"@ue-shed/localization": "workspace:0.24.0",
		"@ue-shed/protocol": "workspace:0.24.0",
		"@ue-shed/unreal-assets": "workspace:0.24.0"
	},
	"devDependencies": {
		"effect": "catalog:"
	},
	"peerDependencies": {
		"effect": "^4.0.0"
	},
	"engines": {
		"node": "^22.15.0 || >=23.8.0"
	}
}
