{
	"schemaVersion": 1,
	"roles": [
		{
			"id": "menu",
			"description": "Saved String Table menu entries",
			"scopes": [
				{
					"matchers": [
						{
							"kind": "location_kind",
							"value": "string_table_entry"
						}
					]
				}
			]
		}
	],
	"rules": [
		{
			"kind": "format_arguments"
		},
		{
			"kind": "argument_modifiers"
		},
		{
			"kind": "rich_text"
		},
		{
			"kind": "po_escape_safety"
		},
		{
			"kind": "whitespace"
		},
		{
			"kind": "empty_translation"
		},
		{
			"kind": "missing_translator_notes"
		},
		{
			"kind": "duplicate_source"
		},
		{
			"kind": "format_argument_renamed"
		},
		{
			"kind": "rich_text_tags"
		},
		{
			"kind": "rich_text_tag_case"
		},
		{
			"kind": "line_breaks"
		},
		{
			"kind": "length_outlier"
		},
		{
			"kind": "outdated_translation"
		},
		{
			"kind": "inconsistent_translation"
		},
		{
			"kind": "rich_text_tags_added"
		},
		{
			"kind": "source_line_endings_changed"
		},
		{
			"kind": "placeholder_translation"
		},
		{
			"kind": "culture_invariant_text"
		},
		{
			"kind": "placeholder_text"
		},
		{
			"kind": "source_whitespace"
		},
		{
			"kind": "source_markup"
		},
		{
			"kind": "number_only_text"
		},
		{
			"kind": "string_table_key_collision"
		},
		{
			"kind": "localization_character_budget",
			"id": "menu.translation-budget",
			"role": "menu",
			"cultures": {
				"de": 32,
				"fr": 36
			},
			"defaultMaximumCharacters": 28,
			"recovery": "Shorten the translation to the authored culture budget."
		},
		{
			"kind": "localization_terminology",
			"id": "menu.translation-terms",
			"role": "menu",
			"caseSensitive": false,
			"cultures": {
				"de": [
					{
						"kind": "preferred",
						"term": "Fortsetzen",
						"alternatives": ["Weiter"]
					}
				],
				"fr": [
					{
						"kind": "forbidden",
						"term": "gameplay"
					}
				]
			},
			"recovery": "Use the culture's project terminology."
		}
	]
}
