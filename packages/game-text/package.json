{
	"name": "@ue-shed/game-text",
	"version": "0.19.0",
	"description": "Headless saved-package corpus discovery and search for Unreal Engine text.",
	"homepage": "https://github.com/ue-shed/ue-shed#readme",
	"bugs": {
		"url": "https://github.com/ue-shed/ue-shed/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ue-shed/ue-shed.git",
		"directory": "packages/game-text"
	},
	"files": [
		"dist",
		"ADOPTING.md",
		"adoption.manifest.json",
		"README.md",
		"LICENSE"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./browser": {
			"types": "./dist/browser.d.ts",
			"import": "./dist/browser.js"
		},
		"./schema": {
			"types": "./dist/entry-schema.d.ts",
			"import": "./dist/entry-schema.js"
		},
		"./rules": {
			"types": "./dist/entry-rules.d.ts",
			"import": "./dist/entry-rules.js"
		},
		"./checks": {
			"types": "./dist/entry-checks.d.ts",
			"import": "./dist/entry-checks.js"
		},
		"./labels": {
			"types": "./dist/entry-labels.d.ts",
			"import": "./dist/entry-labels.js"
		},
		"./corpus": {
			"types": "./dist/entry-corpus.d.ts",
			"import": "./dist/entry-corpus.js"
		},
		"./index": {
			"types": "./dist/entry-index.d.ts",
			"import": "./dist/entry-index.js"
		},
		"./workspace": {
			"types": "./dist/entry-workspace.d.ts",
			"import": "./dist/entry-workspace.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "node ../../scripts/clean-package-dist.ts && tsc -p tsconfig.build.json",
		"prepack": "pnpm run build",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@ue-shed/localization": "workspace:0.19.0",
		"@ue-shed/protocol": "workspace:0.19.0",
		"@ue-shed/unreal-assets": "workspace:0.19.0",
		"@ue-shed/unreal-connection": "workspace:0.19.0",
		"linebreak": "1.1.0"
	},
	"devDependencies": {
		"effect": "catalog:"
	},
	"peerDependencies": {
		"effect": "^4.0.0"
	},
	"engines": {
		"node": "^22.15.0 || >=23.8.0"
	}
}
