{
	"name": "@ue-shed/map-history",
	"version": "0.21.0",
	"description": "Headless Perforce-backed history and playback for saved Unreal Engine maps.",
	"homepage": "https://github.com/ue-shed/ue-shed#readme",
	"bugs": {
		"url": "https://github.com/ue-shed/ue-shed/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ue-shed/ue-shed.git",
		"directory": "packages/map-history"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./contract": {
			"types": "./dist/schema.d.ts",
			"import": "./dist/schema.js"
		},
		"./playback": {
			"types": "./dist/playback.d.ts",
			"import": "./dist/playback.js"
		},
		"./diff": {
			"types": "./dist/diff.d.ts",
			"import": "./dist/diff.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "node ../../scripts/clean-package-dist.ts && tsc -p tsconfig.build.json",
		"prepack": "pnpm run build",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@ue-shed/protocol": "workspace:0.21.0",
		"@ue-shed/unreal-assets": "workspace:0.21.0",
		"p4client-ts": "0.13.0"
	},
	"devDependencies": {
		"@effect/vitest": "catalog:",
		"effect": "catalog:"
	},
	"peerDependencies": {
		"effect": "^4.0.0"
	},
	"engines": {
		"node": ">=22.14.0"
	}
}
