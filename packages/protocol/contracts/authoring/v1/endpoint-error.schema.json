{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$defs": {
		"AuthoringEndpointError": {
			"type": "object",
			"properties": {
				"code": {
					"type": "string"
				},
				"message": {
					"type": "string"
				},
				"status": {
					"type": "string",
					"enum": ["error"]
				}
			},
			"required": ["code", "message", "status"],
			"additionalProperties": false
		}
	},
	"$ref": "#/$defs/AuthoringEndpointError"
}
