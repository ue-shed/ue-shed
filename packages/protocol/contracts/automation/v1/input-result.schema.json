{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$defs": {
		"AutomationInputResult": {
			"type": "object",
			"properties": {
				"contract": {
					"type": "object",
					"properties": {
						"name": {
							"type": "string",
							"enum": ["unreal-automation-input"]
						},
						"version": {
							"type": "object",
							"properties": {
								"major": {
									"type": "number",
									"enum": [1]
								},
								"minor": {
									"type": "number",
									"enum": [0]
								}
							},
							"required": ["major", "minor"],
							"additionalProperties": false
						}
					},
					"required": ["name", "version"],
					"additionalProperties": false
				},
				"status": {
					"type": "string",
					"enum": ["injected", "rejected"]
				},
				"worldObjectPath": {
					"type": "string"
				},
				"playerControllerObjectPath": {
					"type": "string"
				},
				"actionObjectPath": {
					"type": "string"
				},
				"errors": {
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"code": {
								"type": "string",
								"allOf": [
									{
										"minLength": 1
									}
								]
							},
							"message": {
								"type": "string"
							}
						},
						"required": ["code", "message"],
						"additionalProperties": false
					}
				}
			},
			"required": [
				"contract",
				"status",
				"worldObjectPath",
				"playerControllerObjectPath",
				"actionObjectPath",
				"errors"
			],
			"additionalProperties": false
		}
	},
	"$ref": "#/$defs/AutomationInputResult"
}
