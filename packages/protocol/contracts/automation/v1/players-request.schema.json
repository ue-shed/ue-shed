{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$defs": {
		"AutomationPlayersRequest": {
			"type": "object",
			"properties": {
				"contract": {
					"type": "object",
					"properties": {
						"name": {
							"type": "string",
							"enum": ["unreal-automation-players"]
						},
						"version": {
							"type": "object",
							"properties": {
								"major": {
									"type": "number",
									"enum": [1]
								},
								"minor": {
									"type": "number",
									"enum": [0]
								}
							},
							"required": ["major", "minor"],
							"additionalProperties": false
						}
					},
					"required": ["name", "version"],
					"additionalProperties": false
				},
				"worldObjectPath": {
					"type": "string",
					"allOf": [
						{
							"minLength": 1
						},
						{
							"maxLength": 2048
						},
						{
							"pattern": "^\\/[^\\u0000-\\u001f]*$"
						}
					]
				}
			},
			"required": ["contract", "worldObjectPath"],
			"additionalProperties": false
		}
	},
	"$ref": "#/$defs/AutomationPlayersRequest"
}
