{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://ue-shed.dev/contracts/cameras/authoring/v1/arrangement.schema.json",
	"type": "object",
	"properties": {
		"version": {
			"type": "number",
			"enum": [1]
		},
		"id": {
			"type": "string",
			"allOf": [
				{
					"pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
				}
			]
		},
		"revision": {
			"type": "integer",
			"allOf": [
				{
					"minimum": 0,
					"maximum": 9007199254740991
				}
			]
		},
		"projectName": {
			"type": "string",
			"allOf": [
				{
					"minLength": 1
				}
			]
		},
		"mapPath": {
			"type": "string",
			"allOf": [
				{
					"minLength": 1
				}
			]
		},
		"subject": {
			"anyOf": [
				{
					"type": "object",
					"properties": {
						"actorGuid": {
							"type": "string",
							"allOf": [
								{
									"pattern": "^(?!00000000-00000000-00000000-00000000$)[0-9a-fA-F]{8}(?:-[0-9a-fA-F]{8}){3}$"
								}
							]
						},
						"diagnosticLabel": {
							"anyOf": [
								{
									"type": "string",
									"allOf": [
										{
											"minLength": 1
										}
									]
								},
								{
									"type": "null"
								}
							]
						},
						"kind": {
							"type": "string",
							"enum": ["actor_guid"]
						},
						"lastKnownActorPath": {
							"anyOf": [
								{
									"type": "string",
									"allOf": [
										{
											"minLength": 7
										},
										{
											"maxLength": 4096
										},
										{
											"pattern": "^\\/Game\\/"
										}
									]
								},
								{
									"type": "null"
								}
							]
						}
					},
					"required": ["actorGuid", "kind"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"actorPath": {
							"type": "string",
							"allOf": [
								{
									"minLength": 7
								},
								{
									"maxLength": 4096
								},
								{
									"pattern": "^\\/Game\\/"
								}
							]
						},
						"diagnosticLabel": {
							"anyOf": [
								{
									"type": "string",
									"allOf": [
										{
											"minLength": 1
										}
									]
								},
								{
									"type": "null"
								}
							]
						},
						"kind": {
							"type": "string",
							"enum": ["actor_path"]
						}
					},
					"required": ["actorPath", "kind"],
					"additionalProperties": false
				}
			]
		},
		"bounds": {
			"type": "object",
			"properties": {
				"center": {
					"type": "object",
					"properties": {
						"x": {
							"type": "number"
						},
						"y": {
							"type": "number"
						},
						"z": {
							"type": "number"
						}
					},
					"required": ["x", "y", "z"],
					"additionalProperties": false
				},
				"extent": {
					"type": "object",
					"properties": {
						"x": {
							"type": "number",
							"allOf": [
								{
									"minimum": 0
								}
							]
						},
						"y": {
							"type": "number",
							"allOf": [
								{
									"minimum": 0
								}
							]
						},
						"z": {
							"type": "number",
							"allOf": [
								{
									"minimum": 0
								}
							]
						}
					},
					"required": ["x", "y", "z"],
					"additionalProperties": false
				},
				"rotation": {
					"type": "object",
					"properties": {
						"pitch": {
							"type": "number"
						},
						"roll": {
							"type": "number"
						},
						"yaw": {
							"type": "number"
						}
					},
					"required": ["pitch", "roll", "yaw"],
					"additionalProperties": false
				}
			},
			"required": ["center", "extent", "rotation"],
			"additionalProperties": false
		},
		"settings": {
			"type": "object",
			"properties": {
				"fieldOfViewDegrees": {
					"type": "number",
					"allOf": [
						{
							"minimum": 5,
							"maximum": 170
						}
					]
				},
				"distanceScale": {
					"type": "number",
					"allOf": [
						{
							"minimum": 0.01,
							"maximum": 100
						}
					]
				},
				"heightOffset": {
					"type": "number"
				},
				"margin": {
					"type": "number",
					"allOf": [
						{
							"minimum": 0,
							"maximum": 0.45
						}
					]
				}
			},
			"required": ["fieldOfViewDegrees", "distanceScale", "heightOffset", "margin"],
			"additionalProperties": false
		},
		"cameras": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string",
						"allOf": [
							{
								"pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
							}
						]
					},
					"displayName": {
						"type": "string",
						"allOf": [
							{
								"minLength": 1
							}
						]
					},
					"yawDegrees": {
						"type": "number"
					},
					"overrides": {
						"type": "object",
						"properties": {
							"fieldOfViewDegrees": {
								"type": "number",
								"allOf": [
									{
										"minimum": 5,
										"maximum": 170
									}
								]
							},
							"distanceScale": {
								"type": "number",
								"allOf": [
									{
										"minimum": 0.01,
										"maximum": 100
									}
								]
							},
							"heightOffset": {
								"type": "number"
							},
							"margin": {
								"type": "number",
								"allOf": [
									{
										"minimum": 0,
										"maximum": 0.45
									}
								]
							}
						},
						"additionalProperties": false
					},
					"manualPose": {
						"type": "object",
						"properties": {
							"aspectRatio": {
								"type": "string",
								"enum": ["16:9"]
							},
							"fieldOfViewDegrees": {
								"type": "number",
								"allOf": [
									{
										"minimum": 5,
										"maximum": 170
									}
								]
							},
							"location": {
								"type": "object",
								"properties": {
									"x": {
										"type": "number"
									},
									"y": {
										"type": "number"
									},
									"z": {
										"type": "number"
									}
								},
								"required": ["x", "y", "z"],
								"additionalProperties": false
							},
							"projection": {
								"type": "string",
								"enum": ["perspective"]
							},
							"rotation": {
								"type": "object",
								"properties": {
									"pitch": {
										"type": "number"
									},
									"roll": {
										"type": "number"
									},
									"yaw": {
										"type": "number"
									}
								},
								"required": ["pitch", "roll", "yaw"],
								"additionalProperties": false
							}
						},
						"required": [
							"aspectRatio",
							"fieldOfViewDegrees",
							"location",
							"projection",
							"rotation"
						],
						"additionalProperties": false
					},
					"viewId": {
						"type": "string",
						"allOf": [
							{
								"minLength": 1
							},
							{
								"pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
							}
						]
					}
				},
				"required": ["id", "displayName", "yawDegrees", "overrides", "viewId"],
				"additionalProperties": false
			},
			"allOf": [
				{
					"minItems": 1
				},
				{
					"maxItems": 256
				}
			]
		},
		"retiredCameraIds": {
			"type": "array",
			"items": {
				"type": "string",
				"allOf": [
					{
						"pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
					}
				]
			}
		},
		"captureProfileId": {
			"type": "string",
			"allOf": [
				{
					"minLength": 1
				},
				{
					"pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
				}
			]
		},
		"visibilityPolicyId": {
			"type": "string",
			"allOf": [
				{
					"minLength": 1
				},
				{
					"pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
				}
			]
		}
	},
	"required": [
		"version",
		"id",
		"revision",
		"projectName",
		"mapPath",
		"subject",
		"bounds",
		"settings",
		"cameras",
		"retiredCameraIds",
		"captureProfileId",
		"visibilityPolicyId"
	],
	"additionalProperties": false,
	"$defs": {}
}
