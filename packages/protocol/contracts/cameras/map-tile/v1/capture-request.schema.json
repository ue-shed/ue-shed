{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://ue-shed.dev/contracts/cameras/map-tile/v1/capture-request.schema.json",
	"type": "object",
	"properties": {
		"capture": {
			"type": "object",
			"properties": {
				"visibility": {
					"type": "object",
					"properties": {
						"hide": {
							"type": "array",
							"items": {
								"type": "object",
								"properties": {
									"locator": {
										"anyOf": [
											{
												"type": "object",
												"properties": {
													"kind": {
														"type": "string",
														"enum": ["actor_path"]
													},
													"actorPath": {
														"type": "string",
														"allOf": [
															{
																"pattern": "^\\/Game\\/"
															},
															{
																"maxLength": 4096
															}
														]
													}
												},
												"required": ["kind", "actorPath"],
												"additionalProperties": false
											},
											{
												"type": "object",
												"properties": {
													"kind": {
														"type": "string",
														"enum": ["actor_guid"]
													},
													"actorGuid": {
														"type": "string",
														"allOf": [
															{
																"pattern": "^(?!00000000-00000000-00000000-00000000$)[0-9a-fA-F]{8}(?:-[0-9a-fA-F]{8}){3}$"
															}
														]
													},
													"lastKnownActorPath": {
														"type": "string",
														"allOf": [
															{
																"maxLength": 4096
															}
														]
													}
												},
												"required": [
													"kind",
													"actorGuid",
													"lastKnownActorPath"
												],
												"additionalProperties": false
											}
										]
									},
									"label": {
										"type": "string",
										"allOf": [
											{
												"maxLength": 256
											}
										]
									}
								},
								"required": ["locator", "label"],
								"additionalProperties": false
							},
							"allOf": [
								{
									"maxItems": 256
								}
							]
						},
						"protect": {
							"type": "array",
							"items": {
								"type": "object",
								"properties": {
									"locator": {
										"anyOf": [
											{
												"type": "object",
												"properties": {
													"kind": {
														"type": "string",
														"enum": ["actor_path"]
													},
													"actorPath": {
														"type": "string",
														"allOf": [
															{
																"pattern": "^\\/Game\\/"
															},
															{
																"maxLength": 4096
															}
														]
													}
												},
												"required": ["kind", "actorPath"],
												"additionalProperties": false
											},
											{
												"type": "object",
												"properties": {
													"kind": {
														"type": "string",
														"enum": ["actor_guid"]
													},
													"actorGuid": {
														"type": "string",
														"allOf": [
															{
																"pattern": "^(?!00000000-00000000-00000000-00000000$)[0-9a-fA-F]{8}(?:-[0-9a-fA-F]{8}){3}$"
															}
														]
													},
													"lastKnownActorPath": {
														"type": "string",
														"allOf": [
															{
																"maxLength": 4096
															}
														]
													}
												},
												"required": [
													"kind",
													"actorGuid",
													"lastKnownActorPath"
												],
												"additionalProperties": false
											}
										]
									},
									"label": {
										"type": "string",
										"allOf": [
											{
												"maxLength": 256
											}
										]
									}
								},
								"required": ["locator", "label"],
								"additionalProperties": false
							},
							"allOf": [
								{
									"maxItems": 256
								}
							]
						}
					},
					"required": ["hide", "protect"],
					"additionalProperties": false
				},
				"dataLayers": {
					"anyOf": [
						{
							"type": "object",
							"properties": {
								"mode": {
									"type": "string",
									"enum": ["unchanged"]
								}
							},
							"required": ["mode"],
							"additionalProperties": false
						},
						{
							"type": "object",
							"properties": {
								"mode": {
									"type": "string",
									"enum": ["explicit"]
								},
								"states": {
									"type": "array",
									"items": {
										"type": "object",
										"properties": {
											"name": {
												"type": "string",
												"allOf": [
													{
														"minLength": 1
													},
													{
														"maxLength": 1024
													}
												]
											},
											"state": {
												"type": "string",
												"enum": ["unloaded", "loaded", "activated"]
											}
										},
										"required": ["name", "state"],
										"additionalProperties": false
									},
									"allOf": [
										{
											"maxItems": 64
										}
									]
								}
							},
							"required": ["mode", "states"],
							"additionalProperties": false
						}
					]
				},
				"orientation": {
					"type": "object",
					"properties": {
						"pitch": {
							"type": "number",
							"enum": [-90]
						},
						"roll": {
							"type": "number",
							"enum": [0]
						},
						"yaw": {
							"type": "number",
							"enum": [0]
						}
					},
					"required": ["pitch", "roll", "yaw"],
					"additionalProperties": false
				},
				"render": {
					"type": "object",
					"properties": {
						"exposureEV100": {
							"type": "number",
							"allOf": [
								{
									"minimum": -20,
									"maximum": 30
								}
							]
						},
						"effects": {
							"type": "object",
							"properties": {
								"fog": {
									"type": "boolean"
								},
								"volumetricFog": {
									"type": "boolean"
								}
							},
							"required": ["fog", "volumetricFog"],
							"additionalProperties": false
						},
						"lodDistanceScaleByZoom": {
							"type": "array",
							"items": {
								"type": "number",
								"allOf": [
									{
										"minimum": 0.1,
										"maximum": 100
									}
								]
							},
							"allOf": [
								{
									"minItems": 1
								},
								{
									"maxItems": 24
								}
							]
						},
						"lodPolicy": {
							"type": "string",
							"enum": ["natural", "fixed_lod_zero", "per_level_distance_scale"]
						},
						"profile": {
							"type": "string",
							"enum": [
								"full_fidelity",
								"seam_stable",
								"scene_capture_defaults",
								"observation"
							]
						}
					},
					"required": ["effects", "lodPolicy", "profile"],
					"additionalProperties": false
				},
				"z": {
					"type": "number"
				}
			},
			"required": ["dataLayers", "orientation", "render", "z"],
			"additionalProperties": false
		},
		"captureBackend": {
			"type": "string",
			"enum": ["lit_camera_tiles", "scene_capture_tiles", "viewport_high_resolution"]
		},
		"overviewBounds": {
			"type": "object",
			"properties": {
				"minX": {
					"type": "number"
				},
				"minY": {
					"type": "number"
				},
				"maxX": {
					"type": "number"
				},
				"maxY": {
					"type": "number"
				}
			},
			"required": ["minX", "minY", "maxX", "maxY"],
			"additionalProperties": false
		},
		"contract": {
			"type": "object",
			"properties": {
				"name": {
					"type": "string",
					"enum": ["ue-shed-map-tile-capture"]
				},
				"version": {
					"type": "object",
					"properties": {
						"major": {
							"type": "number",
							"enum": [1]
						},
						"minor": {
							"type": "number",
							"enum": [0, 1, 2]
						}
					},
					"required": ["major", "minor"],
					"additionalProperties": false
				}
			},
			"required": ["name", "version"],
			"additionalProperties": false
		},
		"correlationId": {
			"type": "string",
			"allOf": [
				{
					"pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
				}
			]
		},
		"expectedMapPath": {
			"type": "string",
			"allOf": [
				{
					"pattern": "^\\/[A-Za-z0-9_./-]+$"
				}
			]
		},
		"gutterPixels": {
			"type": "integer",
			"allOf": [
				{
					"minimum": 0,
					"maximum": 32
				}
			]
		},
		"operationId": {
			"type": "string",
			"allOf": [
				{
					"pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
				}
			]
		},
		"planId": {
			"type": "string",
			"allOf": [
				{
					"pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
				}
			]
		},
		"runId": {
			"type": "string",
			"allOf": [
				{
					"pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
				}
			]
		},
		"tilePixelSize": {
			"type": "integer",
			"allOf": [
				{
					"minimum": 64,
					"maximum": 4096
				}
			]
		},
		"tiles": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"key": {
						"type": "object",
						"properties": {
							"zoom": {
								"type": "integer",
								"allOf": [
									{
										"minimum": 0
									}
								]
							},
							"row": {
								"type": "integer",
								"allOf": [
									{
										"minimum": 0
									}
								]
							},
							"column": {
								"type": "integer",
								"allOf": [
									{
										"minimum": 0
									}
								]
							}
						},
						"required": ["zoom", "row", "column"],
						"additionalProperties": false
					},
					"unitsPerPixel": {
						"type": "number",
						"allOf": [
							{
								"exclusiveMinimum": 0
							}
						]
					},
					"worldBounds": {
						"type": "object",
						"properties": {
							"minX": {
								"type": "number"
							},
							"minY": {
								"type": "number"
							},
							"maxX": {
								"type": "number"
							},
							"maxY": {
								"type": "number"
							}
						},
						"required": ["minX", "minY", "maxX", "maxY"],
						"additionalProperties": false
					}
				},
				"required": ["key", "unitsPerPixel", "worldBounds"],
				"additionalProperties": false
			},
			"allOf": [
				{
					"minItems": 1
				},
				{
					"maxItems": 64
				}
			]
		}
	},
	"required": [
		"capture",
		"contract",
		"correlationId",
		"expectedMapPath",
		"gutterPixels",
		"operationId",
		"planId",
		"runId",
		"tilePixelSize",
		"tiles"
	],
	"additionalProperties": false,
	"$defs": {}
}
