{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://ue-shed.dev/contracts/cameras/map-tile/v1/manifest.schema.json",
	"title": "UE Shed neutral map tile pyramid manifest v1.0",
	"description": "Cross-field grid and exhaustive-completion invariants are additionally enforced by conformant producers and decoders.",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"addressing",
		"capturePolicy",
		"completedAt",
		"contract",
		"failures",
		"grid",
		"gutter",
		"levels",
		"planId",
		"project",
		"provenance",
		"runId",
		"startedAt",
		"state",
		"tilePixelSize",
		"tiles"
	],
	"properties": {
		"addressing": {
			"type": "object",
			"additionalProperties": false,
			"required": ["children", "parent", "path"],
			"properties": {
				"children": { "const": "z+1: (2r,2c),(2r,2c+1),(2r+1,2c),(2r+1,2c+1)" },
				"parent": { "const": "z-1: (floor(r/2),floor(c/2))" },
				"path": { "const": "Z{zoom:02}/R{row:03}_C{column:03}.png" }
			}
		},
		"capturePolicy": { "$ref": "plan.schema.json#/$defs/capturePolicy" },
		"completedAt": { "$ref": "#/$defs/timestamp" },
		"contract": {
			"type": "object",
			"additionalProperties": false,
			"required": ["name", "version"],
			"properties": {
				"name": { "const": "ue-shed-map-tile-pyramid" },
				"version": { "$ref": "plan.schema.json#/$defs/version" }
			}
		},
		"failures": {
			"type": "array",
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["failure", "key"],
				"properties": {
					"failure": { "$ref": "capture-response.schema.json#/$defs/failure" },
					"key": { "$ref": "capture-request.schema.json#/$defs/tileKey" }
				}
			}
		},
		"grid": {
			"type": "object",
			"additionalProperties": false,
			"required": ["orientation", "origin", "requestedBounds", "snappedBounds"],
			"properties": {
				"orientation": {
					"type": "object",
					"additionalProperties": false,
					"required": ["name", "version"],
					"properties": {
						"name": { "const": "rows_max_x_to_min_x_columns_min_y_to_max_y" },
						"version": { "const": 1 }
					}
				},
				"origin": {
					"type": "object",
					"additionalProperties": false,
					"required": ["x", "y"],
					"properties": { "x": { "type": "number" }, "y": { "type": "number" } }
				},
				"requestedBounds": { "$ref": "plan.schema.json#/$defs/bounds" },
				"snappedBounds": { "$ref": "plan.schema.json#/$defs/bounds" }
			}
		},
		"gutter": {
			"type": "object",
			"additionalProperties": false,
			"required": ["pixels", "rule", "textureAddress"],
			"properties": {
				"pixels": { "type": "integer", "minimum": 0, "maximum": 32 },
				"rule": { "const": "render_overdraw_then_crop" },
				"textureAddress": { "const": "clamp_to_edge" }
			}
		},
		"levels": {
			"type": "array",
			"minItems": 1,
			"maxItems": 24,
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["columns", "rows", "tileWorldSize", "unitsPerPixel", "zoom"],
				"properties": {
					"columns": { "type": "integer", "minimum": 1 },
					"rows": { "type": "integer", "minimum": 1 },
					"tileWorldSize": { "type": "number", "exclusiveMinimum": 0 },
					"unitsPerPixel": { "type": "number", "exclusiveMinimum": 0 },
					"zoom": { "type": "integer", "minimum": 0 }
				}
			}
		},
		"planId": { "$ref": "plan.schema.json#/$defs/id" },
		"project": { "$ref": "plan.schema.json#/$defs/project" },
		"provenance": {
			"type": "object",
			"additionalProperties": false,
			"required": ["producer", "tool", "toolVersion"],
			"properties": {
				"producer": { "type": "string", "minLength": 1, "maxLength": 1024 },
				"tool": { "const": "ue-shed" },
				"toolVersion": { "type": "string", "minLength": 1, "maxLength": 1024 }
			}
		},
		"runId": { "$ref": "plan.schema.json#/$defs/id" },
		"startedAt": { "$ref": "#/$defs/timestamp" },
		"state": { "enum": ["complete", "partial", "cancelled"] },
		"tilePixelSize": { "type": "integer", "minimum": 64, "maximum": 4096 },
		"tiles": {
			"type": "array",
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": [
					"bytes",
					"hash",
					"height",
					"key",
					"relativePath",
					"width",
					"worldBounds"
				],
				"properties": {
					"bytes": { "type": "integer", "minimum": 1 },
					"hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
					"height": { "type": "integer", "minimum": 1 },
					"key": { "$ref": "capture-request.schema.json#/$defs/tileKey" },
					"relativePath": {
						"type": "string",
						"pattern": "^Z[0-9]{2,}/R[0-9]{3,}_C[0-9]{3,}\\.png$"
					},
					"width": { "type": "integer", "minimum": 1 },
					"worldBounds": { "$ref": "plan.schema.json#/$defs/bounds" }
				}
			}
		}
	},
	"$defs": {
		"timestamp": {
			"type": "string",
			"pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{3})?Z$"
		}
	}
}
