{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"additionalProperties": false,
	"required": ["schemaVersion", "backend", "ready", "blockers"],
	"properties": {
		"schemaVersion": {
			"const": 1
		},
		"backend": {
			"const": "lit_camera_tiles"
		},
		"ready": {
			"type": "boolean"
		},
		"actualMapPath": {
			"type": "string",
			"minLength": 1
		},
		"blockers": {
			"type": "array",
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["code", "message"],
				"properties": {
					"code": {
						"type": "string",
						"minLength": 1
					},
					"message": {
						"type": "string",
						"minLength": 1
					}
				}
			}
		}
	}
}
