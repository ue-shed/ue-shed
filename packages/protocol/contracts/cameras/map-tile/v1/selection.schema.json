{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"oneOf": [
		{
			"type": "object",
			"additionalProperties": false,
			"required": [
				"schemaVersion",
				"status",
				"mapPath",
				"bounds",
				"actors",
				"skippedActorPaths"
			],
			"properties": {
				"schemaVersion": {
					"const": 1
				},
				"status": {
					"const": "ready"
				},
				"mapPath": {
					"type": "string",
					"minLength": 1
				},
				"bounds": {
					"type": "object",
					"additionalProperties": false,
					"required": ["minX", "maxX", "minY", "maxY", "minZ", "maxZ"],
					"properties": {
						"minX": {
							"type": "number"
						},
						"maxX": {
							"type": "number"
						},
						"minY": {
							"type": "number"
						},
						"maxY": {
							"type": "number"
						},
						"minZ": {
							"type": "number"
						},
						"maxZ": {
							"type": "number"
						}
					}
				},
				"actors": {
					"type": "array",
					"items": {
						"type": "object",
						"additionalProperties": false,
						"required": ["path", "label"],
						"properties": {
							"path": {
								"type": "string",
								"minLength": 1
							},
							"label": {
								"type": "string"
							},
							"actorGuid": {
								"type": "string",
								"pattern": "^[0-9A-Fa-f]{32}$"
							}
						}
					},
					"minItems": 1,
					"maxItems": 1024
				},
				"skippedActorPaths": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"maxItems": 1024
				}
			}
		},
		{
			"type": "object",
			"additionalProperties": false,
			"required": ["schemaVersion", "status", "code", "message"],
			"properties": {
				"schemaVersion": {
					"const": 1
				},
				"status": {
					"const": "unavailable"
				},
				"code": {
					"type": "string",
					"minLength": 1
				},
				"message": {
					"type": "string",
					"minLength": 1
				}
			}
		}
	]
}
