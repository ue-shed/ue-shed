{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://ue-shed.dev/contracts/cameras/provisioning/v1/provision-request.schema.json",
	"title": "UE Shed provisioned camera request v1",
	"type": "object",
	"additionalProperties": false,
	"required": ["schemaVersion", "previewFps", "cameras"],
	"properties": {
		"schemaVersion": { "const": 2 },
		"previewFps": { "type": "integer", "minimum": 1, "maximum": 10 },
		"cameras": {
			"type": "array",
			"minItems": 1,
			"maxItems": 32,
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": [
					"correlation",
					"fieldOfViewDegrees",
					"location",
					"rotation",
					"width",
					"height"
				],
				"properties": {
					"correlation": {
						"oneOf": [
							{
								"type": "object",
								"additionalProperties": false,
								"required": ["type", "candidateId"],
								"properties": {
									"type": { "const": "framing_candidate" },
									"candidateId": {
										"type": "string",
										"minLength": 1,
										"maxLength": 128,
										"pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
									}
								}
							},
							{
								"type": "object",
								"additionalProperties": false,
								"required": ["type", "reviewViewId"],
								"properties": {
									"type": { "const": "review_view" },
									"reviewViewId": {
										"type": "string",
										"minLength": 1,
										"maxLength": 128,
										"pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
									}
								}
							}
						]
					},
					"fieldOfViewDegrees": { "type": "number", "minimum": 5, "maximum": 170 },
					"location": { "$ref": "#/$defs/vector" },
					"rotation": { "$ref": "#/$defs/rotation" },
					"width": { "type": "integer", "minimum": 64, "maximum": 2560 },
					"height": { "type": "integer", "minimum": 64, "maximum": 1440 }
				}
			}
		}
	},
	"$defs": {
		"vector": {
			"type": "object",
			"additionalProperties": false,
			"required": ["x", "y", "z"],
			"properties": {
				"x": { "type": "number" },
				"y": { "type": "number" },
				"z": { "type": "number" }
			}
		},
		"rotation": {
			"type": "object",
			"additionalProperties": false,
			"required": ["pitch", "yaw", "roll"],
			"properties": {
				"pitch": { "type": "number" },
				"yaw": { "type": "number" },
				"roll": { "type": "number" }
			}
		}
	}
}
