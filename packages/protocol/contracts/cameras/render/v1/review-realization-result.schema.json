												},
												"y": {
													"type": "number"
												},
												"z": {
													"type": "number"
												}
											},
											"required": ["x", "y", "z"],
											"additionalProperties": false
										},
										"rotation": {
											"type": "object",
											"properties": {
												"pitch": {
													"type": "number"
												},
												"roll": {
													"type": "number"
												},
												"yaw": {
													"type": "number"
												}
											},
											"required": ["pitch", "roll", "yaw"],
											"additionalProperties": false
										}
									},
									"required": ["location", "rotation"],
									"additionalProperties": false
								}
							},
							"required": ["actorGuid", "actorPath", "kind", "transform"],
							"additionalProperties": false
						},
						{
							"type": "object",
							"properties": {
