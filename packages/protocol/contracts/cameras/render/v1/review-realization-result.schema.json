												},
												"z": {
													"type": "number"
												}
											},
											"required": ["x", "y", "z"],
											"additionalProperties": false
										},
										"rotation": {
											"type": "object",
											"properties": {
												"pitch": {
													"type": "number"
												},
												"roll": {
													"type": "number"
												},
												"yaw": {
													"type": "number"
