						"aspectRatio": {
							"type": "string",
							"enum": ["16:9"]
						},
						"fieldOfViewDegrees": {
							"type": "number",
							"allOf": [
								{
									"minimum": 5,
									"maximum": 170
								}
							]
						},
						"location": {
							"type": "object",
							"properties": {
								"x": {
									"type": "number"
								},
								"y": {
									"type": "number"
								},
								"z": {
									"type": "number"
								}
							},
							"required": ["x", "y", "z"],
							"additionalProperties": false
						},
						"projection": {
							"type": "string",
							"enum": ["perspective"]
						},
						"rotation": {
							"type": "object",
							"properties": {
								"pitch": {
									"type": "number"
								},
								"roll": {
									"type": "number"
								},
								"yaw": {
									"type": "number"
								}
							},
							"required": ["pitch", "roll", "yaw"],
							"additionalProperties": false
						}
					},
					"required": [
						"aspectRatio",
						"fieldOfViewDegrees",
