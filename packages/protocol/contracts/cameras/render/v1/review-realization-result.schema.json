										{
											"pattern": "^(?!00000000-00000000-00000000-00000000$)[0-9a-fA-F]{8}(?:-[0-9a-fA-F]{8}){3}$"
										}
									]
								},
								"actorPath": {
									"type": "string",
									"allOf": [
										{
											"minLength": 7
										},
										{
											"maxLength": 4096
										},
										{
											"pattern": "^\\/Game\\/"
										}
									]
								},
								"kind": {
									"type": "string",
									"enum": ["actor_guid"]
								},
								"transform": {
									"type": "object",
									"properties": {
										"location": {
											"type": "object",
											"properties": {
												"x": {
