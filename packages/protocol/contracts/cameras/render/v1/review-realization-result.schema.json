												},
												"y": {
													"type": "number"
												},
												"z": {
													"type": "number"
												}
											},
											"required": ["x", "y", "z"],
											"additionalProperties": false
										},
										"extent": {
											"type": "object",
											"properties": {
												"x": {
													"type": "number",
													"allOf": [
														{
															"minimum": 0
														}
													]
												},
												"y": {
													"type": "number",
													"allOf": [
														{
															"minimum": 0
														}
													]
												},
												"z": {
													"type": "number",
													"allOf": [
														{
															"minimum": 0
														}
													]
												}
											},
											"required": ["x", "y", "z"],
											"additionalProperties": false
										},
										"rotation": {
											"type": "object",
											"properties": {
												"pitch": {
													"type": "number"
												},
												"roll": {
													"type": "number"
												},
												"yaw": {
													"type": "number"
												}
