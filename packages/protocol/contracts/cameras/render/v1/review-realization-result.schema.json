												},
												"lastKnownActorPath": {
													"anyOf": [
														{
															"type": "string",
															"allOf": [
																{
																	"minLength": 7
																},
																{
																	"maxLength": 4096
																},
																{
																	"pattern": "^\\/Game\\/"
																}
															]
														},
														{
															"type": "null"
														}
													]
												}
											},
											"required": ["actorGuid", "kind"],
											"additionalProperties": false
										},
										{
											"type": "object",
