			"type": "object",
			"properties": {
				"status": {
					"type": "string",
					"enum": ["failed"]
				},
				"code": {
					"type": "string",
					"allOf": [
						{
							"minLength": 1
						}
					]
				},
				"message": {
					"type": "string",
					"allOf": [
						{
							"minLength": 1
						}
					]
				},
				"recovery": {
					"type": "string",
					"allOf": [
						{
							"minLength": 1
						}
					]
				}
			},
			"required": ["status", "code", "message", "recovery"],
			"additionalProperties": false
		}
