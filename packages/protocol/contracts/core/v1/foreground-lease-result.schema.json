				"status": {
					"type": "string",
					"enum": ["granted"]
				},
				"schemaVersion": {
					"type": "number",
					"enum": [1]
				},
				"processId": {
					"type": "integer",
					"allOf": [
						{
							"exclusiveMinimum": 0
						},
						{
							"exclusiveMaximum": 4294967295
						}
					]
				},
				"message": {
					"type": "string"
				},
				"recovery": {
					"type": "string"
				},
				"activeLeases": {
					"type": "integer",
					"allOf": [
						{
							"minimum": 0,
							"maximum": 8
						}
					]
				},
				"leaseId": {
					"type": "string",
					"allOf": [
						{
							"pattern": "^[0-9a-f]{32}$"
						}
					]
				},
				"ttlMs": {
					"type": "integer",
					"allOf": [
						{
							"minimum": 2000,
							"maximum": 30000
						}
					]
				}
