{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$defs": {
		"GameTextActionPlace": {
			"type": "object",
			"properties": {
				"packageFile": {
					"type": "string",
					"allOf": [
						{
							"minLength": 1
						},
						{
							"maxLength": 4096
						}
					]
				},
				"objectPath": {
					"type": "string",
					"allOf": [
						{
							"minLength": 1
						},
						{
							"maxLength": 4096
						}
					]
				},
				"propertyPath": {
					"type": "string",
					"allOf": [
						{
							"minLength": 1
						},
						{
							"maxLength": 4096
						}
					]
				},
				"selector": {
					"anyOf": [
						{
							"type": "object",
							"properties": {
								"kind": {
									"type": "string",
									"enum": ["data_table_cell"]
								},
								"row": {
									"type": "string",
									"allOf": [
										{
											"minLength": 1
										},
										{
											"maxLength": 4096
										}
									]
								}
							},
							"required": ["kind", "row"],
							"additionalProperties": false
						},
						{
							"type": "object",
							"properties": {
								"kind": {
									"type": "string",
									"enum": ["string_table_entry"]
								},
								"entryKey": {
									"type": "string",
									"allOf": [
										{
											"minLength": 1
										},
										{
											"maxLength": 4096
										}
									]
								}
							},
							"required": ["kind", "entryKey"],
							"additionalProperties": false
						},
						{
							"type": "object",
							"properties": {
								"kind": {
									"type": "string",
									"enum": ["graph_pin"]
								},
								"pinId": {
									"type": "string",
									"allOf": [
										{
											"minLength": 1
										},
										{
											"maxLength": 4096
										}
									]
								}
							},
							"required": ["kind", "pinId"],
							"additionalProperties": false
						},
						{
							"type": "object",
							"properties": {
								"kind": {
									"type": "string",
									"enum": ["graph_pin"]
								},
								"index": {
									"type": "integer",
									"allOf": [
										{
											"minimum": 0
										},
										{
											"maximum": 2147483647
										}
									]
								}
							},
							"required": ["kind", "index"],
							"additionalProperties": false
						}
					]
				}
			},
			"required": ["packageFile", "objectPath", "propertyPath"],
			"additionalProperties": false
		},
		"GameTextActionIdentity": {
			"anyOf": [
				{
					"type": "object",
					"properties": {
						"namespace": {
							"type": "string",
							"allOf": [
								{
									"maxLength": 4096
								}
							]
						},
						"key": {
							"type": "string",
							"allOf": [
								{
									"minLength": 1
								},
								{
									"maxLength": 4096
								}
							]
						},
						"source": {
							"type": "string",
							"allOf": [
								{
									"maxLength": 4096
								}
							]
						},
						"tableId": {
							"type": "string",
							"allOf": [
								{
									"minLength": 1
								},
								{
									"maxLength": 4096
								}
							]
						}
					},
					"required": ["namespace", "key", "source"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"namespace": {
							"type": "string",
							"enum": [""]
						},
						"key": {
							"type": "string",
							"enum": [""]
						},
						"source": {
							"type": "string",
							"allOf": [
								{
									"maxLength": 4096
								}
							]
						},
						"unresolved": {
							"type": "string",
							"enum": ["culture_invariant", "missing_key", "generated"]
						}
					},
					"required": ["namespace", "key", "source", "unresolved"],
					"additionalProperties": false
				}
			]
		},
		"GameTextActionOutcomeIdentity": {
			"type": "object",
			"properties": {
				"namespace": {
					"type": "string"
				},
				"key": {
					"type": "string"
				},
				"minted": {
					"type": "boolean",
					"enum": [true]
				},
				"source": {
					"type": "string"
				},
				"tableId": {
					"type": "string"
				},
				"unresolved": {
					"type": "string",
					"enum": ["culture_invariant", "missing_key", "generated"]
				},
				"removed": {
					"type": "boolean",
					"enum": [true]
				}
			},
			"required": ["namespace", "source"],
			"additionalProperties": false
		},
		"GameTextActionOutcome": {
			"type": "object",
			"properties": {
				"id": {
					"type": "string"
				},
				"place": {
					"$ref": "#/$defs/GameTextActionPlace"
				},
				"status": {
					"type": "string",
					"enum": ["applied", "planned", "unchanged", "rolled_back", "unknown"]
				},
				"before": {
					"$ref": "#/$defs/GameTextActionIdentity"
				},
				"after": {
					"$ref": "#/$defs/GameTextActionOutcomeIdentity"
				}
			},
			"required": ["id", "place", "status", "before", "after"],
			"additionalProperties": false
		},
		"GameTextActionError": {
			"type": "object",
			"properties": {
				"code": {
					"type": "string",
					"enum": [
						"invalid_request",
						"package_mismatch",
						"place_not_found",
						"not_text",
						"read_only_text",
						"unsupported_place",
						"stale_expected",
						"key_conflict",
						"compile_failed",
						"not_persisted",
						"save_failed",
						"rollback_failed"
					]
				},
				"actionId": {
					"type": "string"
				},
				"message": {
					"type": "string"
				},
				"recovery": {
					"type": "string"
				},
				"retrySafe": {
					"type": "boolean"
				},
				"nextStep": {
					"type": "string",
					"enum": ["fix_input", "retry", "reconcile", "escalate"]
				}
			},
			"required": ["code", "message", "recovery", "retrySafe", "nextStep"],
			"additionalProperties": false
		},
		"GameTextActionsResult": {
			"type": "object",
			"properties": {
				"contract": {
					"type": "string",
					"enum": ["ue-shed-game-text-actions"]
				},
				"version": {
					"type": "string",
					"enum": ["1.0"]
				},
				"mode": {
					"type": "string",
					"enum": ["dry_run", "apply"]
				},
				"status": {
					"type": "string",
					"enum": ["ok", "rejected", "failed"]
				},
				"rolledBack": {
					"type": "boolean"
				},
				"actions": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/GameTextActionOutcome"
					}
				},
				"blueprints": {
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"objectPath": {
								"type": "string"
							},
							"compiled": {
								"type": "boolean"
							}
						},
						"required": ["objectPath", "compiled"],
						"additionalProperties": false
					}
				},
				"packages": {
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"packageName": {
								"type": "string"
							},
							"packageFile": {
								"type": "string"
							},
							"saved": {
								"type": "boolean"
							},
							"persistence": {
								"type": "string",
								"enum": ["saved", "unsaved", "unknown"]
							}
						},
						"required": ["packageName", "packageFile", "saved", "persistence"],
						"additionalProperties": false
					}
				},
				"errors": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/GameTextActionError"
					}
				}
			},
			"required": [
				"contract",
				"version",
				"mode",
				"status",
				"rolledBack",
				"actions",
				"blueprints",
				"packages",
				"errors"
			],
			"additionalProperties": false
		}
	},
	"$ref": "#/$defs/GameTextActionsResult"
}
