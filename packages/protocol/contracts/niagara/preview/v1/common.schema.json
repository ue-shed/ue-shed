{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://ue-shed.dev/contracts/niagara/preview/v1/common.schema.json",
	"$defs": {
		"runId": {
			"type": "string",
			"pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
		},
		"systemObjectPath": {
			"type": "string",
			"maxLength": 1024,
			"pattern": "^/[A-Za-z0-9_]+/[A-Za-z0-9_./-]+\\.[A-Za-z0-9_-]+$"
		},
		"settings": {
			"type": "object",
			"properties": {
				"captureMode": {
					"enum": ["component_only", "full_scene"]
				},
				"durationSeconds": {
					"type": "number",
					"minimum": 0.001,
					"maximum": 600
				},
				"frameCount": {
					"type": "integer",
					"minimum": 1,
					"maximum": 512
				},
				"height": {
					"type": "integer",
					"minimum": 1,
					"maximum": 4096
				},
				"simulationFramesPerSecond": {
					"type": "integer",
					"minimum": 1,
					"maximum": 480
				},
				"startSeconds": {
					"type": "number",
					"minimum": 0,
					"maximum": 3600
				},
				"width": {
					"type": "integer",
					"minimum": 1,
					"maximum": 4096
				},
				"renderMode": {
					"enum": ["transparent", "scene"]
				},
				"cameraMode": {
					"enum": ["saved", "auto_fit"]
				},
				"sceneProfile": {
					"enum": ["ground_impact", "projectile", "aura", "environment"]
				},
				"exposureCompensation": {
					"type": "number",
					"minimum": -8,
					"maximum": 8
				},
				"cameraPadding": {
					"type": "number",
					"minimum": 1.05,
					"maximum": 3
				},
				"background": {
					"enum": ["default", "dark", "light"]
				},
				"cameraOverride": {
					"$ref": "#/$defs/cameraOverride"
				}
			},
			"additionalProperties": false
		},
		"effectiveSettings": {
			"type": "object",
			"required": [
				"captureMode",
				"durationSeconds",
				"frameCount",
				"frameIntervalSeconds",
				"height",
				"playbackFramesPerSecond",
				"simulationFramesPerSecond",
				"startSeconds",
				"width"
			],
			"properties": {
				"captureMode": {
					"enum": ["component_only", "full_scene"]
				},
				"durationSeconds": {
					"type": "number",
					"minimum": 0.001,
					"maximum": 600
				},
				"frameCount": {
					"type": "integer",
					"minimum": 1,
					"maximum": 512
				},
				"frameIntervalSeconds": {
					"type": "number",
					"exclusiveMinimum": 0
				},
				"height": {
					"type": "integer",
					"minimum": 1,
					"maximum": 4096
				},
				"playbackFramesPerSecond": {
					"type": "number",
					"exclusiveMinimum": 0
				},
				"simulationFramesPerSecond": {
					"type": "integer",
					"minimum": 1,
					"maximum": 480
				},
				"startSeconds": {
					"type": "number",
					"minimum": 0,
					"maximum": 3600
				},
				"width": {
					"type": "integer",
					"minimum": 1,
					"maximum": 4096
				},
				"renderMode": {
					"enum": ["transparent", "scene"]
				},
				"cameraMode": {
					"enum": ["saved", "auto_fit"]
				},
				"sceneProfile": {
					"enum": ["ground_impact", "projectile", "aura", "environment"]
				},
				"exposureCompensation": {
					"type": "number",
					"minimum": -8,
					"maximum": 8
				},
				"cameraPadding": {
					"type": "number",
					"minimum": 1.05,
					"maximum": 3
				},
				"background": {
					"enum": ["default", "dark", "light"]
				},
				"cameraOverride": {
					"$ref": "#/$defs/cameraOverride"
				}
			},
			"additionalProperties": false
		},
		"camera": {
			"type": "object",
			"required": [
				"aspectRatio",
				"fieldOfViewDegrees",
				"location",
				"orthoWidth",
				"projection",
				"rotation",
				"usesCustomAspectRatio"
			],
			"properties": {
				"aspectRatio": {
					"type": "number",
					"exclusiveMinimum": 0
				},
				"fieldOfViewDegrees": {
					"type": "number",
					"minimum": 0,
					"maximum": 180
				},
				"location": {
					"$ref": "#/$defs/vector"
				},
				"orthoWidth": {
					"type": "number",
					"minimum": 0
				},
				"projection": {
					"enum": ["orthographic", "perspective"]
				},
				"rotation": {
					"$ref": "#/$defs/rotator"
				},
				"usesCustomAspectRatio": {
					"type": "boolean"
				}
			},
			"additionalProperties": false
		},
		"vector": {
			"type": "object",
			"required": ["x", "y", "z"],
			"properties": {
				"x": {
					"type": "number"
				},
				"y": {
					"type": "number"
				},
				"z": {
					"type": "number"
				}
			},
			"additionalProperties": false
		},
		"rotator": {
			"type": "object",
			"required": ["pitch", "roll", "yaw"],
			"properties": {
				"pitch": {
					"type": "number"
				},
				"roll": {
					"type": "number"
				},
				"yaw": {
					"type": "number"
				}
			},
			"additionalProperties": false
		},
		"cameraOverride": {
			"type": "object",
			"required": ["location", "rotation", "fieldOfViewDegrees"],
			"properties": {
				"location": {
					"type": "object",
					"required": ["x", "y", "z"],
					"properties": {
						"x": {
							"type": "number",
							"minimum": -1000000000000,
							"maximum": 1000000000000
						},
						"y": {
							"type": "number",
							"minimum": -1000000000000,
							"maximum": 1000000000000
						},
						"z": {
							"type": "number",
							"minimum": -1000000000000,
							"maximum": 1000000000000
						}
					},
					"additionalProperties": false
				},
				"rotation": {
					"type": "object",
					"required": ["pitch", "yaw", "roll"],
					"properties": {
						"pitch": {
							"type": "number",
							"minimum": -1000000000000,
							"maximum": 1000000000000
						},
						"yaw": {
							"type": "number",
							"minimum": -1000000000000,
							"maximum": 1000000000000
						},
						"roll": {
							"type": "number",
							"minimum": -1000000000000,
							"maximum": 1000000000000
						}
					},
					"additionalProperties": false
				},
				"fieldOfViewDegrees": {
					"type": "number",
					"minimum": 1,
					"maximum": 179
				}
			},
			"additionalProperties": false
		}
	}
}
