{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"additionalProperties": false,
	"required": ["schemaVersion", "runId", "phase", "completedFrames", "totalFrames", "elapsedMs"],
	"properties": {
		"schemaVersion": {
			"const": 1
		},
		"runId": {
			"type": "string",
			"minLength": 1
		},
		"phase": {
			"enum": [
				"initializing",
				"compiling",
				"camera_fitting",
				"capturing",
				"writing_receipt",
				"completed"
			]
		},
		"completedFrames": {
			"type": "integer",
			"minimum": 0
		},
		"totalFrames": {
			"type": "integer",
			"minimum": 1
		},
		"elapsedMs": {
			"type": "number",
			"minimum": 0
		}
	}
}
