{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://ue-shed.dev/contracts/niagara/preview/v1/receipt.schema.json",
	"type": "object",
	"required": [
		"alphaPolicy",
		"camera",
		"colorSpace",
		"contract",
		"effectiveSettings",
		"engineVersion",
		"frames",
		"generatedAtUtc",
		"requestedSettings",
		"runId",
		"status",
		"systemObjectPath"
	],
	"properties": {
		"alphaPolicy": { "const": "scene_opacity_or_emissive_coverage_v1" },
		"camera": { "$ref": "common.schema.json#/$defs/camera" },
		"colorSpace": { "const": "srgb" },
		"contract": {
			"type": "object",
			"required": ["name", "version"],
			"properties": {
				"name": { "const": "ue-shed-niagara-preview-receipt" },
				"version": {
					"type": "object",
					"required": ["major", "minor"],
					"properties": { "major": { "const": 1 }, "minor": { "const": 0 } },
					"additionalProperties": false
				}
			},
			"additionalProperties": false
		},
		"effectiveSettings": { "$ref": "common.schema.json#/$defs/effectiveSettings" },
		"engineVersion": { "type": "string", "minLength": 1 },
		"frames": {
			"type": "array",
			"minItems": 1,
			"items": {
				"type": "object",
				"required": [
					"index",
					"maximumRgb",
					"nonTransparentPixelFraction",
					"relativePath",
					"timeSeconds"
				],
				"properties": {
					"index": { "type": "integer", "minimum": 0 },
					"maximumRgb": { "type": "number", "minimum": 0, "maximum": 1 },
					"nonTransparentPixelFraction": { "type": "number", "minimum": 0, "maximum": 1 },
					"relativePath": {
						"type": "string",
						"pattern": "^frames/frame_[0-9]{4}\\.png$"
					},
					"timeSeconds": { "type": "number", "minimum": 0 }
				},
				"additionalProperties": false
			}
		},
		"generatedAtUtc": { "type": "string", "minLength": 1 },
		"requestedSettings": { "$ref": "common.schema.json#/$defs/settings" },
		"runId": { "$ref": "common.schema.json#/$defs/runId" },
		"status": { "const": "complete" },
		"systemObjectPath": { "$ref": "common.schema.json#/$defs/systemObjectPath" }
	},
	"additionalProperties": false
}
