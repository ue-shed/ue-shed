							"$ref": "#/$defs/UAssetIoNonEmptyString"
						},
						"expectedGeneration": {
							"$ref": "#/$defs/UAssetIoPositiveInt"
						},
						"limit": {
							"type": "integer",
							"allOf": [
								{
									"exclusiveMinimum": 0
								},
								{
									"maximum": 1024
								}
							]
						},
						"projectId": {
							"$ref": "#/$defs/UAssetIoNonEmptyString"
						},
						"values": {
							"type": "array",
							"items": {
								"$ref": "#/$defs/UAssetIoNonEmptyString"
							},
							"allOf": [
								{
									"minItems": 1
								},
								{
									"maxItems": 64
								}
							]
						}
					},
					"required": ["kind", "expectedGeneration", "limit", "projectId", "values"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"type": "string",
							"enum": ["class_name_suffixes"]
