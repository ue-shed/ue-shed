						"classPrefixes": {
							"type": "array",
							"items": {
								"$ref": "#/$defs/UAssetIoNonEmptyString"
							}
						},
						"classes": {
							"type": "array",
							"items": {
								"$ref": "#/$defs/UAssetIoNonEmptyString"
							}
						},
						"names": {
							"type": "array",
							"items": {
								"$ref": "#/$defs/UAssetIoNonEmptyString"
							}
						},
						"inventory": {
							"type": "boolean"
						},
						"kind": {
							"type": "string",
							"enum": ["scan"]
						}
