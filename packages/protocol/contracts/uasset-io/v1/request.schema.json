						"projectRoot": {
							"$ref": "#/$defs/UAssetIoNonEmptyString"
						}
					},
					"required": ["kind", "cacheRoot", "projectRoot"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"type": "string",
							"enum": ["project_index_refresh"]
						},
						"cacheRoot": {
							"$ref": "#/$defs/UAssetIoNonEmptyString"
						},
						"projectRoot": {
							"$ref": "#/$defs/UAssetIoNonEmptyString"
						}
					},
					"required": ["kind", "cacheRoot", "projectRoot"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"type": "string",
							"enum": ["project_index_rebuild"]
						},
						"cacheRoot": {
							"$ref": "#/$defs/UAssetIoNonEmptyString"
						},
						"projectRoot": {
							"$ref": "#/$defs/UAssetIoNonEmptyString"
						}
					},
					"required": ["kind", "cacheRoot", "projectRoot"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"cacheRoot": {
							"$ref": "#/$defs/UAssetIoNonEmptyString"
						},
						"kind": {
							"type": "string",
							"enum": ["project_index_query"]
						},
						"query": {
							"$ref": "#/$defs/UAssetIoProjectIndexQuery"
						}
					},
					"required": ["cacheRoot", "kind", "query"],
					"additionalProperties": false
				}
			]
		},
		"UAssetIoRequest": {
			"type": "object",
			"properties": {
				"contract": {
					"$ref": "#/$defs/UAssetIoContract"
				},
				"limits": {
					"$ref": "#/$defs/UAssetIoResourceLimits"
				},
				"operation": {
					"$ref": "#/$defs/UAssetIoOperation"
				},
				"requestId": {
					"$ref": "#/$defs/UAssetIoNonEmptyString"
				}
			},
			"required": ["contract", "limits", "operation", "requestId"],
			"additionalProperties": false
		}
	},
	"$ref": "#/$defs/UAssetIoRequest"
}
