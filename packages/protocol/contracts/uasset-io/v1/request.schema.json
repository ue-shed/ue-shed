						"paths": {
							"type": "array",
							"items": {
								"$ref": "#/$defs/UAssetIoNonEmptyString"
							}
						},
						"projectRoot": {
							"$ref": "#/$defs/UAssetIoNonEmptyString"
						},
						"kind": {
							"type": "string",
							"enum": ["extract_texture"]
						}
					},
					"required": ["projectRoot", "kind"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"type": "string",
							"enum": ["saved_world"]
						},
						"mapPath": {
							"$ref": "#/$defs/UAssetIoNonEmptyString"
						},
						"projectRoot": {
							"$ref": "#/$defs/UAssetIoNonEmptyString"
						}
					},
					"required": ["kind", "mapPath", "projectRoot"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"type": "string",
							"enum": ["project_index_status"]
						},
						"cacheRoot": {
							"$ref": "#/$defs/UAssetIoNonEmptyString"
