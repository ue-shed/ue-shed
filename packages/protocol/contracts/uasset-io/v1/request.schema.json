{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$defs": {
		"UAssetIoNonNegativeInt": {
			"type": "integer",
			"description": "an integer",
			"title": "int",
			"minimum": 0
		},
		"UAssetIoContract": {
			"type": "object",
			"properties": {
				"name": {
					"type": "string",
					"enum": ["uasset-io"]
				},
				"version": {
					"type": "object",
					"properties": {
						"major": {
							"type": "number",
							"enum": [1]
						},
						"minor": {
							"$ref": "#/$defs/UAssetIoNonNegativeInt"
						}
					},
					"required": ["major", "minor"],
					"additionalProperties": false
				}
			},
			"required": ["name", "version"],
			"additionalProperties": false
		},
		"UAssetIoPositiveInt": {
			"type": "integer",
			"description": "an integer",
			"title": "int",
			"exclusiveMinimum": 0
		},
		"UAssetIoResourceLimits": {
			"type": "object",
			"properties": {
				"concurrency": {
					"$ref": "#/$defs/UAssetIoPositiveInt"
				},
				"maximumAssets": {
					"$ref": "#/$defs/UAssetIoNonNegativeInt"
				},
				"maximumOutputBytes": {
					"$ref": "#/$defs/UAssetIoPositiveInt"
				},
				"timeoutMs": {
					"$ref": "#/$defs/UAssetIoPositiveInt"
				}
			},
			"additionalProperties": false
		},
		"UAssetIoNonEmptyString": {
			"type": "string",
			"description": "a string at least 1 character(s) long",
			"title": "string",
			"minLength": 1
		},
		"UAssetIoProjectIndexQuery": {
