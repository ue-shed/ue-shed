{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "UE Shed saved Level Sequence record v4",
	"type": "object",
	"properties": {
		"schema_version": {
			"const": 4
		},
		"object_path": {
			"type": "string"
		},
		"movie_scene_path": {
			"anyOf": [
				{
					"type": "string"
				},
				{
					"type": "null"
				}
			]
		},
		"tick_resolution": {
			"anyOf": [
				{
					"$ref": "#/$defs/rate"
				},
				{
					"type": "null"
				}
			]
		},
		"display_rate": {
			"anyOf": [
				{
					"$ref": "#/$defs/rate"
				},
				{
					"type": "null"
				}
			]
		},
		"playback_range": {
			"anyOf": [
				{
					"$ref": "#/$defs/range"
				},
				{
					"type": "null"
				}
			]
		},
		"bindings": {
			"type": "array",
			"items": {
				"$ref": "#/$defs/binding"
			},
			"maxItems": 1000000
		},
		"root_tracks": {
			"type": "array",
			"items": {
				"$ref": "#/$defs/track"
			},
			"maxItems": 1000000
		},
		"references": {
			"type": "array",
			"items": {
				"$ref": "#/$defs/reference"
			},
			"maxItems": 1000000
		},
		"reference_coverage_gaps": {
			"type": "array",
			"items": {
				"$ref": "#/$defs/referenceGap"
			},
			"maxItems": 1000000
		},
		"coverage_gaps": {
			"type": "array",
			"items": {
				"$ref": "#/$defs/gap"
			},
			"maxItems": 1000000
		}
	},
	"required": [
		"schema_version",
		"object_path",
		"movie_scene_path",
		"tick_resolution",
		"display_rate",
		"playback_range",
		"bindings",
		"root_tracks",
		"references",
		"reference_coverage_gaps",
		"coverage_gaps"
	],
	"additionalProperties": false,
	"$defs": {
		"rate": {
			"type": "object",
			"properties": {
				"numerator": {
					"type": "integer"
				},
				"denominator": {
					"type": "integer",
					"minimum": 1
				}
			},
			"required": ["numerator", "denominator"],
			"additionalProperties": false
		},
		"bound": {
			"type": "object",
			"properties": {
				"kind": {
					"enum": ["exclusive", "inclusive", "open"]
				},
				"frame": {
					"type": "integer"
				}
			},
			"required": ["kind", "frame"],
			"additionalProperties": false
		},
		"range": {
			"type": "object",
			"properties": {
				"lower": {
					"$ref": "#/$defs/bound"
				},
				"upper": {
					"$ref": "#/$defs/bound"
				}
			},
			"required": ["lower", "upper"],
			"additionalProperties": false
		},
		"textKey": {
			"type": "object",
			"properties": {
				"frame": {
					"type": "integer"
				},
				"source": {
					"type": "string"
				},
				"identity": {
					"anyOf": [
						{
							"type": "object",
							"properties": {
								"status": {
									"const": "resolved"
								},
								"namespace": {
									"type": "string"
								},
								"key": {
									"type": "string"
								}
							},
							"required": ["status", "namespace", "key"],
							"additionalProperties": false
						},
						{
							"type": "object",
							"properties": {
								"status": {
									"const": "unresolved"
								}
							},
							"required": ["status"],
							"additionalProperties": false
						}
					]
				}
			},
			"required": ["frame", "source", "identity"],
			"additionalProperties": false
		},
		"numericKey": {
			"type": "object",
			"properties": {
				"frame": {
					"type": "integer"
				},
				"value": {
					"type": "number"
				},
				"interpolation": {
					"type": "integer",
					"minimum": 0,
					"maximum": 255
				},
				"tangent_mode": {
					"type": "integer",
					"minimum": 0,
					"maximum": 255
				},
				"tangent_weight_mode": {
					"type": "integer",
					"minimum": 0,
					"maximum": 255
				},
				"arrive_tangent": {
					"type": "number"
				},
				"leave_tangent": {
					"type": "number"
				},
				"arrive_tangent_weight": {
					"type": "number"
				},
				"leave_tangent_weight": {
					"type": "number"
				}
			},
			"required": [
				"frame",
				"value",
				"interpolation",
				"tangent_mode",
				"tangent_weight_mode",
				"arrive_tangent",
				"leave_tangent",
				"arrive_tangent_weight",
				"leave_tangent_weight"
			],
			"additionalProperties": false
		},
		"numericChannel": {
			"type": "object",
			"properties": {
				"property_path": {
					"type": "string"
				},
				"enabled": {
					"anyOf": [
						{
							"type": "boolean"
						},
						{
							"type": "null"
						}
					]
				},
				"default_value": {
					"anyOf": [
						{
							"type": "number"
						},
						{
							"type": "null"
						}
					]
				},
				"pre_extrapolation": {
					"type": "integer",
					"minimum": 0,
					"maximum": 255
				},
				"post_extrapolation": {
					"type": "integer",
					"minimum": 0,
					"maximum": 255
				},
				"tick_resolution": {
					"$ref": "#/$defs/rate"
				},
				"show_curve": {
					"type": "boolean"
				},
				"keys": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/numericKey"
					},
					"maxItems": 1000000
				}
			},
			"required": [
				"property_path",
				"enabled",
				"default_value",
				"pre_extrapolation",
				"post_extrapolation",
				"tick_resolution",
				"show_curve",
				"keys"
			],
			"additionalProperties": false
		},
		"section": {
			"type": "object",
			"properties": {
				"object_path": {
					"type": "string"
				},
				"class_path": {
					"type": "string"
				},
				"range": {
					"anyOf": [
						{
							"$ref": "#/$defs/range"
						},
						{
							"type": "null"
						}
					]
				},
				"sequence_path": {
					"anyOf": [
						{
							"type": "string"
						},
						{
							"type": "null"
						}
					]
				},
				"shot_display_name": {
					"anyOf": [
						{
							"type": "string"
						},
						{
							"type": "null"
						}
					]
				},
				"text_keys": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/textKey"
					},
					"maxItems": 1000000
				},
				"numeric_channels": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/numericChannel"
					},
					"maxItems": 1000000
				}
			},
			"required": [
				"object_path",
				"class_path",
				"range",
				"sequence_path",
				"shot_display_name",
				"text_keys",
				"numeric_channels"
			],
			"additionalProperties": false
		},
		"track": {
			"type": "object",
			"properties": {
				"object_path": {
					"type": "string"
				},
				"class_path": {
					"type": "string"
				},
				"property_path": {
					"anyOf": [
						{
							"type": "string"
						},
						{
							"type": "null"
						}
					]
				},
				"content": {
					"enum": [
						"timed_text",
						"sub_sequence",
						"cinematic_shot",
						"numeric",
						"transform",
						"structure_only"
					]
				},
				"sections": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/section"
					},
					"maxItems": 1000000
				}
			},
			"required": ["object_path", "class_path", "property_path", "content", "sections"],
			"additionalProperties": false
		},
		"binding": {
			"type": "object",
			"properties": {
				"id": {
					"type": "string"
				},
				"name": {
					"anyOf": [
						{
							"type": "string"
						},
						{
							"type": "null"
						}
					]
				},
				"possessed_object_class": {
					"anyOf": [
						{
							"type": "string"
						},
						{
							"type": "null"
						}
					]
				},
				"tracks": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/track"
					},
					"maxItems": 1000000
				}
			},
			"required": ["id", "name", "possessed_object_class", "tracks"],
			"additionalProperties": false
		},
		"reference": {
			"type": "object",
			"properties": {
				"owner_path": {
					"type": "string"
				},
				"owner_class_path": {
					"type": "string"
				},
				"property_path": {
					"type": "string"
				},
				"kind": {
					"enum": ["object", "soft_object", "data_table_row_handle"]
				},
				"target_path": {
					"type": "string"
				},
				"target_row": {
					"type": "string"
				},
				"scope": {
					"enum": ["internal", "external"]
				}
			},
			"required": [
				"owner_path",
				"owner_class_path",
				"property_path",
				"kind",
				"target_path",
				"scope"
			],
			"additionalProperties": false
		},
		"referenceGap": {
			"type": "object",
			"properties": {
				"owner_path": {
					"type": "string"
				},
				"property_path": {
					"type": "string"
				},
				"reason": {
					"enum": [
						"raw_property_value",
						"native_object_tail",
						"unresolved_object_reference"
					]
				}
			},
			"required": ["owner_path", "property_path", "reason"],
			"additionalProperties": false
		},
		"gap": {
			"type": "object",
			"properties": {
				"object_path": {
					"type": "string"
				},
				"property_path": {
					"type": "string"
				},
				"reason": {
					"enum": [
						"missing_reference",
						"wrong_value_kind",
						"mismatched_channel_lengths",
						"unsupported_track_content",
						"unsupported_section_content",
						"missing_channel",
						"missing_channel_mask"
					]
				}
			},
			"required": ["object_path", "property_path", "reason"],
			"additionalProperties": false
		}
	}
}
