{
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"exactOptionalPropertyTypes": true,
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"noEmit": true,
		"noUncheckedIndexedAccess": true,
		"strict": true,
		"target": "ES2024",
		"types": ["node"]
	},
	"include": ["src/**/*.js", "src/**/*.d.ts"]
}
